HOST=127.0.0.1
PORT=18994
PUBLIC_BASE_PATH=/admin/pioneer-credit
DATA_DIR=./data

# Sub 管理端服务地址，用于服务端校验当前访问者是否为管理员。
SUB_BASE_URL=http://127.0.0.1:18080
SUB_ADMIN_VERIFY_PATH=/api/v1/auth/me

# 反向代理注入到 X-Internal-Proxy-Secret 的共享密钥。生产环境必须改成强随机值。
INTERNAL_PROXY_SECRET=change-this-secret
AUTH_REQUIRED=true
TRUST_PROXY=true

NODE_ENV=production
BROWSER_HEADLESS=true
HEADED_AUTH=true
AUTH_TIMEOUT_MS=600000
AUTH_REMOTE_DEBUGGING_PORT=0

SCREENSHOT_ON_FAILURE=true
MAX_FAILURE_SCREENSHOTS=50
LOG_RETENTION_DAYS=30

# Docker Compose 外部网络名。按你的 sub 管理端实际网络修改。
SUB2API_NETWORK=sub2api-network
